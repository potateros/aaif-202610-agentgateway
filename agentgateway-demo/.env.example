# Copy to .env and edit. `make config` renders config.yaml from these.

# The real model provider: any OpenAI-compatible API. Never commit .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# The upstream model id, e.g. gpt-4o-mini. The demo was built on GLM-5.3 Flash; any chat model works.
LLM_MODEL=

# Optional Langfuse tracing. Leave keys blank to disable tracing.
LANGFUSE_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
